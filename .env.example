APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Имейл: локално log или Mailtrap. На production при блокиран SMTP ползвайте Resend (HTTPS).
# След git pull: composer install --no-dev -o (иначе Class "Resend" not found при MAIL_MAILER=resend).
# Ако Composer спре с proc_open: първо composer install --no-dev -o --no-scripts, после махнете proc_open от disable_functions в php.ini (CLI) или поискайте от хостинга; после php artisan package:discover.
# Пакети: resend/resend-laravel + resend/resend-php. Пример:
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_xxxx
#   MAIL_FROM_ADDRESS=verified@your-domain.com   (задължително; без него Resend често гърми)
# След всяка промяна на .env: php artisan config:clear (иначе остава стар smtp от кеш)
# (в Resend верифицирайте домейна; за тест има onboarding@resend.dev)
# Алтернатива: SMTP с MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT, MAIL_ENCRYPTION=tls|ssl, ...
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (https://resend.com) — без SMTP; ключ: влез в акаунта → API Keys → Create API Key (започва с re_)
# RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenAI (ChatGPT) — използва се за генериране на анкети
AI_API_PUBLIC_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VERIFY_SSL=false

# SEO (опционално; иначе се ползват стойностите от config/seo.php)
# SEO_DEFAULT_TITLE=
# SEO_DESCRIPTION=
# SEO_KEYWORDS=
# SEO_OG_IMAGE=/images/og-default.png
# SEO_TWITTER_SITE=yourhandle
